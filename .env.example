NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://lyonix:lyonix_local_only@localhost:5432/lyonix
RABBITMQ_URL=amqp://localhost:5672
MEDIA_ROOT=./data/media
MEDIA_TTL_DAYS=7
# VE2E-36 media-worker (the only FFmpeg process; started by pnpm dev via apps/worker run-workers).
# Requires ffmpeg + ffprobe (with libx264) on PATH, or absolute paths below.
MEDIA_WORKER_QUEUE=lyonix.media
FFMPEG_PATH=
FFPROBE_PATH=
# clip.prepare: max keyframe start/duration drift (ms) accepted for stream copy before re-encode (DEC-2026-09-29: 1000).
MEDIA_WORKER_COPY_TOLERANCE_MS=1000
MEDIA_WORKER_JOB_TIMEOUT_MS=120000
MEDIA_WORKER_MAX_ATTEMPTS=2
# VE2E-61: parallel clip.prepare jobs. Empty = min(3, CPU count); always capped at the CPU count.
MEDIA_WORKER_PREFETCH=
# VE2E-61: FFmpeg -threads per job. Empty = floor(CPU count / prefetch), min 1.
MEDIA_WORKER_FFMPEG_THREADS=
# VE2E-61 concurrency (workflow worker process; empty = default; invalid values fall back to the default with a warning).
# Auto runs in flight at once (default 5, 1..64) and scenes voiced in parallel inside one run (default 3, 1..8).
# DEC-2026-10-02-CAPACITY-250 (50 concurrent): only raise after `corepack pnpm --filter @lyonix/api report:capacity` and a load test; see 08-DEPLOY-OPERATIONS sizing.
WORKFLOW_CONCURRENCY=
WORKFLOW_VOICE_PARALLELISM=
# Max in-flight provider calls across ALL jobs in the process (1..64; never above the provider PLAN's own concurrency cap). Defaults: content 3, apify 3, pexels 3, elevenlabs 2, creatomate 2.
# Callers over the limit wait FIFO up to PROVIDER_LIMIT_WAIT_TIMEOUT_MS (default 120000), then get a retryable PROVIDER_RATE_LIMITED.
# Creatomate's own concurrent-render cap belongs to the account plan; this only queues on our side.
PROVIDER_CONCURRENCY_CONTENT=
PROVIDER_CONCURRENCY_APIFY=
PROVIDER_CONCURRENCY_PEXELS=
PROVIDER_CONCURRENCY_ELEVENLABS=
PROVIDER_CONCURRENCY_CREATOMATE=
PROVIDER_LIMIT_WAIT_TIMEOUT_MS=
# Prisma connection pool size per process (1..200; empty = Prisma default num_cpus*2+1). Sets `connection_limit` on DATABASE_URL unless the URL already has one.
# 50 concurrent Auto runs need more than the default: size it to roughly WORKFLOW_CONCURRENCY + API request headroom, within Postgres max_connections.
DATABASE_POOL_SIZE=
# VE2E-37: API/workflow worker wait per clip.prepare result before failing the render (MEDIA_PREPARE_FAILED).
MEDIA_PREPARE_TIMEOUT_MS=180000
WEB_ORIGIN=http://localhost:5173
# Publicly reachable base URL for this API, required so Creatomate (or any external
# render provider) can fetch /media-delivery/:token. Preflight fails closed
# (PROVIDER_NOT_CONFIGURED) when unset — no auto-fallback to a local/private URL.
PUBLIC_BASE_URL=http://localhost:3000
# VE2E-13: Creatomate JavaScript Preview SDK browser public token (project settings in the
# Creatomate dashboard) - NOT the render API secret key, safe to expose client-side by
# Creatomate's own design. Leave unset to keep Studio's Preview SDK panel in its explicit
# "not configured" fallback state (PROVIDER_NOT_CONFIGURED-equivalent) - B10/B11 gate the
# owner actually supplying this.
CREATOMATE_PREVIEW_PUBLIC_TOKEN=
# VE2E-52b: explicit Creatomate render_scale sent on every final render (0.1..1, default 1 = full canvas).
# Creatomate applied 0.25 (270x480) on the owner's account when none was sent; the actual result is shown in Studio.
CREATOMATE_RENDER_SCALE=1
# Caps the root frame_rate (1..60) of dynamic/source renders only (Auto, Studio final render + preview); empty = keep the template's own value.
# Credits and render time scale with frame_rate (credits = width x height x fps x seconds / 100,000,000): a 60 fps template costs 2x a 30 fps one.
# template_id renders are unchanged - edit such a template's own frame_rate in Creatomate.
CREATOMATE_FRAME_RATE=
# Development-only demo credentials. Configure production users through the database/secrets manager.
DEMO_ADMIN_PASSWORD=lyonix-admin
DEMO_STAFF_PASSWORD=lyonix-staff
# Required to persist provider/TikTok secrets: base64-encoded 32-byte AES-256-GCM key.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PERSISTENCE_ENCRYPTION_KEY=
# HMAC secret for access/refresh JWTs (HttpOnly cookies lyonix_access / lyonix_refresh).
JWT_SECRET=
# Access JWT lifetime in seconds (default 900). Refresh default 2592000 (30d).
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5173/callback/
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list

# VE2E-40: allowed range for a user-fixed background segment count (placeholder 1..6; misconfigured -> 1..6)
BACKGROUND_SEGMENTS_MIN_COUNT=1
BACKGROUND_SEGMENTS_MAX_COUNT=6
