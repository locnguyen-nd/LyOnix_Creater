NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://lyonix:lyonix_local_only@localhost:5432/lyonix
RABBITMQ_URL=amqp://localhost:5672
MEDIA_ROOT=./data/media
MEDIA_TTL_DAYS=7
# VE2E-36 media-worker (the only FFmpeg process; started by pnpm dev via apps/worker run-workers).
# Requires ffmpeg + ffprobe (with libx264) on PATH, or absolute paths below.
MEDIA_WORKER_QUEUE=lyonix.media
FFMPEG_PATH=
FFPROBE_PATH=
# clip.prepare: max keyframe start/duration drift (ms) accepted for stream copy before re-encode (DEC-2026-09-29: 1000).
MEDIA_WORKER_COPY_TOLERANCE_MS=1000
MEDIA_WORKER_JOB_TIMEOUT_MS=120000
MEDIA_WORKER_MAX_ATTEMPTS=2
# VE2E-61: parallel clip.prepare jobs. Empty = min(3, CPU count); always capped at the CPU count.
MEDIA_WORKER_PREFETCH=
# VE2E-61: FFmpeg -threads per job. Empty = floor(CPU count / prefetch), min 1.
MEDIA_WORKER_FFMPEG_THREADS=
# VE2E-134: per-job-type queues. API: MEDIA_QUEUE_SPLIT=1 routes frame.extract/reframe.analyze to <queue>.frame / <queue>.reframe
# (clip.prepare stays on MEDIA_WORKER_QUEUE, compose on the render queue). Turn it on ONLY after every media-worker is upgraded
# (a new worker always consumes the legacy queue too; an old worker never reads the split queues). Default off = old behaviour.
MEDIA_QUEUE_SPLIT=
# Worker prefetch per type (empty = old shared MEDIA_WORKER_PREFETCH; compose empty = MEDIA_WORKER_RENDER_PREFETCH). Capped at the CPU count.
MEDIA_WORKER_PREFETCH_CLIP_PREPARE=
MEDIA_WORKER_PREFETCH_FRAME_EXTRACT=
MEDIA_WORKER_PREFETCH_REFRAME_ANALYZE=
MEDIA_WORKER_PREFETCH_COMPOSE=
# VE2E-90: ffprobe smoothness check of each cut (1 default; 0 disables)
MEDIA_WORKER_SMOOTH_CHECK=1
# VE2E-144..148 (CR-MEDIA-OSS-FETCH): yt-dlp / gallery-dl downloads + searches, worker side (queue lyonix.media.fetch).
# Install: pip install "yt-dlp[default,curl-cffi]" gallery-dl ; YouTube also needs Deno >= 2.3 on PATH. Missing tools only fail
# media.fetch jobs with FETCH_TOOL_MISSING (the API then falls back to Apify); every other job type is unaffected.
MEDIA_WORKER_FETCH=1
MEDIA_WORKER_QUEUE_FETCH=lyonix.media.fetch
MEDIA_WORKER_PREFETCH_FETCH=4
YTDLP_PATH=
GALLERY_DL_PATH=
# Optional proxy for retries after a 403 / bot check (http(s):// or socks5://). Never logged.
MEDIA_FETCH_PROXY=
# API side: every switch is OFF until a live probe (VE2E-149) is done on this machine.
# MEDIA_FETCH_YTDLP=1 -> TikTok phase 2 via yt-dlp (Apify download stays the fallback)
# MEDIA_FETCH_GALLERYDL=1 -> gallery-dl search + download tier (Pinterest images; X needs cookies)
# MEDIA_SOURCE_YT_SHORTS=1 -> YouTube Shorts search + download tier (DEC-2026-10-08-SOCIAL-FETCH-OSS)
MEDIA_FETCH_YTDLP=0
MEDIA_FETCH_GALLERYDL=0
MEDIA_SOURCE_YT_SHORTS=0
MEDIA_FETCH_TIMEOUT_MS=60000
# Last API-side recovery step: one run through the worker proxy (MEDIA_FETCH_PROXY) after cookies failed. Cookie cool-down after a bot check / 429.
MEDIA_FETCH_USE_PROXY=0
MEDIA_FETCH_COOKIE_COOLDOWN_MS=1800000
# Shorts tier: longest Short accepted (s); gallery tier platform (pinterest | x).
MEDIA_SHORTS_MAX_SECONDS=180
MEDIA_GALLERY_PLATFORM=pinterest
# Platform circuit breaker: skip the OSS tools of a platform for COOLDOWN_MS when >= RATIO of the last WINDOW_MS downloads hit 403/bot-check/cookies.
MEDIA_FETCH_BREAKER_WINDOW_MS=600000
MEDIA_FETCH_BREAKER_RATIO=0.5
MEDIA_FETCH_BREAKER_MIN_SAMPLES=4
MEDIA_FETCH_BREAKER_COOLDOWN_MS=900000
# VE2E-105 video.compose = internal `lyonix` render engine (1080x1920, 60 fps CFR). Own queue so a long render never blocks clip.prepare.
MEDIA_WORKER_RENDER_QUEUE=lyonix.render
# Parallel renders (1..4, capped at the CPU count). 1 is right for a laptop: one 1080p60 encode already uses every core.
MEDIA_WORKER_RENDER_PREFETCH=1
# x264 preset (ultrafast|superfast|veryfast|faster|fast|medium|slow) and threads per render (0 = FFmpeg decides).
RENDER_X264_PRESET=faster
RENDER_X264_THREADS=0
# Hard wall-clock limit of one video FFmpeg run (ms).
RENDER_JOB_TIMEOUT_MS=900000
# Extra fonts directory for libass (Noto Sans JP, M PLUS Rounded 1c ...). Empty = system fonts only.
RENDER_FONTS_DIR=
# VE2E-109/110 Render Router (API). Fallback to a paid provider is capped; overflow to a provider when the internal queue is long is OFF by default.
RENDER_FALLBACK_DAILY_USD=50
RENDER_FALLBACK_MONTHLY_USD=
RENDER_OVERFLOW_ENABLED=false
RENDER_OVERFLOW_SLA_MS=600000
# Estimated USD per CPU-hour of the machine that renders internally (0 = unknown/free); internal cost = CPU-seconds / 3600 x this.
RENDER_LOCAL_USD_PER_CPU_HOUR=0
# VE2E-66 reframe.analyze (subject + overlay -> CropPlan). Local detectors (onnxruntime-node), models OUTSIDE git:
#   corepack pnpm --filter @lyonix/media-worker models:download   (SHA-256 verified; missing model => job error MODEL_NOT_AVAILABLE)
REFRAME_MODELS_DIR=
# Max reframe.analyze jobs running detectors at once in this process (default floor(CPU/4) >= 1) and onnxruntime threads per model (default 1).
REFRAME_CONCURRENCY=
REFRAME_ORT_THREADS=
# Analysis frame long side in px (default 448), max frames (12), OCR frames (4) and OCR bands (top 25% / bottom 60% of the frame).
REFRAME_ANALYSIS_LONG_SIDE=
REFRAME_MAX_FRAMES=
REFRAME_TEXT_MAX_FRAMES=
REFRAME_TEXT_TOP_PCT=
REFRAME_TEXT_BOTTOM_PCT=
# Preset logo corner margins for TikTok/Apify sources (% of width/height, defaults 30 / 10).
REFRAME_LOGO_CORNER_WIDTH_PCT=
REFRAME_LOGO_CORNER_HEIGHT_PCT=
# Optional known-logo template matching: comma separated reference JPEG paths, logo width in % of the frame (12), NCC threshold (0.8).
REFRAME_LOGO_TEMPLATES=
REFRAME_LOGO_TEMPLATE_WIDTH_PCT=
REFRAME_LOGO_TEMPLATE_THRESHOLD=
# Planner (packages/domain planReframe): max zoom (default 1.35), optional pan cap px/s and smoothing ms.
REFRAME_MAX_ZOOM=1.35
# Zoom spent only to dodge the PRESET corner margins of social clips (guessed watermark areas, "soft"): default 1.15. Hard overlays (detected text, logo templates) may use REFRAME_MAX_ZOOM.
REFRAME_SOFT_MAX_ZOOM=
# Hard-overlay residual (percent of the overlay still inside the crop) accepted before a plan counts as overlay_unavoidable (default 15; 0 = any residual).
REFRAME_UNAVOIDABLE_MIN_PCT=
REFRAME_MAX_PAN_PX_PER_SEC=
REFRAME_SMOOTHING_MS=
# VE2E-67 API/render side: apply the crop plan when cutting clips (clip.prepare cropPlan).
# On/off (default on); origins that are reframed: comma list of apify,pexels,upload,import_url,generated or all/none (default apify).
REFRAME_ENABLED=1
REFRAME_ENABLED_ORIGINS=apify
# Analysis unavailable (MODEL_NOT_AVAILABLE, worker down, timeout): 1 = fall back to the OLD centre crop with a logged warning + flag in the result (default), 0 = fail the render.
REFRAME_LEGACY_FALLBACK=1
# Auto: an overlay_unavoidable Apify candidate is rejected so another source is tried (default 1); 0 = only flag it. Studio always only flags it.
REFRAME_AUTO_SWAP_ON_OVERLAY=1
# Wait per reframe.analyze request in ms (default 180000).
REFRAME_ANALYZE_TIMEOUT_MS=
# VE2E-61 concurrency (workflow worker process; empty = default; invalid values fall back to the default with a warning).
# Auto runs in flight at once (default 5, 1..64) and scenes voiced in parallel inside one run (default 3, 1..8).
# DEC-2026-10-02-CAPACITY-250 (50 concurrent): only raise after `corepack pnpm --filter @lyonix/api report:capacity` and a load test; see 08-DEPLOY-OPERATIONS sizing.
WORKFLOW_CONCURRENCY=
WORKFLOW_VOICE_PARALLELISM=
# Max in-flight provider calls across ALL jobs in the process (1..64; never above the provider PLAN's own concurrency cap). Defaults: content 3, apify 3, pexels 3, elevenlabs 2, creatomate 2.
# Callers over the limit wait FIFO up to PROVIDER_LIMIT_WAIT_TIMEOUT_MS (default 120000), then get a retryable PROVIDER_RATE_LIMITED.
# Creatomate's own concurrent-render cap belongs to the account plan; this only queues on our side.
PROVIDER_CONCURRENCY_CONTENT=
PROVIDER_CONCURRENCY_APIFY=
PROVIDER_CONCURRENCY_PEXELS=
PROVIDER_CONCURRENCY_ELEVENLABS=
PROVIDER_CONCURRENCY_CREATOMATE=
PROVIDER_LIMIT_WAIT_TIMEOUT_MS=
# Prisma connection pool size per process (1..200; empty = Prisma default num_cpus*2+1). Sets `connection_limit` on DATABASE_URL unless the URL already has one.
# 50 concurrent Auto runs need more than the default: size it to roughly WORKFLOW_CONCURRENCY + API request headroom, within Postgres max_connections.
DATABASE_POOL_SIZE=
# VE2E-37: API/workflow worker wait per clip.prepare result before failing the render (MEDIA_PREPARE_FAILED).
MEDIA_PREPARE_TIMEOUT_MS=180000
WEB_ORIGIN=http://localhost:5173
# Publicly reachable base URL for this API, required so Creatomate (or any external
# render provider) can fetch /media-delivery/:token. Preflight fails closed
# (PROVIDER_NOT_CONFIGURED) when unset — no auto-fallback to a local/private URL.
PUBLIC_BASE_URL=http://localhost:3000
# VE2E-13: Creatomate JavaScript Preview SDK browser public token (project settings in the
# Creatomate dashboard) - NOT the render API secret key, safe to expose client-side by
# Creatomate's own design. Leave unset to keep Studio's Preview SDK panel in its explicit
# "not configured" fallback state (PROVIDER_NOT_CONFIGURED-equivalent) - B10/B11 gate the
# owner actually supplying this.
CREATOMATE_PREVIEW_PUBLIC_TOKEN=
# VE2E-52b: explicit Creatomate render_scale sent on every final render (0.1..1, default 1 = full canvas).
# Creatomate applied 0.25 (270x480) on the owner's account when none was sent; the actual result is shown in Studio.
CREATOMATE_RENDER_SCALE=1
# Caps the root frame_rate (1..60) of dynamic/source renders only (Auto, Studio final render + preview); empty = keep the template's own value.
# Credits and render time scale with frame_rate (credits = width x height x fps x seconds / 100,000,000): a 60 fps template costs 2x a 30 fps one.
# template_id renders are unchanged - edit such a template's own frame_rate in Creatomate.
CREATOMATE_FRAME_RATE=
# Development-only demo credentials. Configure production users through the database/secrets manager.
DEMO_ADMIN_PASSWORD=lyonix-admin
DEMO_STAFF_PASSWORD=lyonix-staff
# Required to persist provider/TikTok secrets: base64-encoded 32-byte AES-256-GCM key.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PERSISTENCE_ENCRYPTION_KEY=
# HMAC secret for access/refresh JWTs (HttpOnly cookies lyonix_access / lyonix_refresh).
JWT_SECRET=
# Access JWT lifetime in seconds (default 900). Refresh default 2592000 (30d).
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5173/callback/
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list

# VE2E-40: allowed range for a user-fixed background segment count (placeholder 1..6; misconfigured -> 1..6)
BACKGROUND_SEGMENTS_MIN_COUNT=1
BACKGROUND_SEGMENTS_MAX_COUNT=6
# Auto script: a draft far outside the narration budget (e.g. 28 s of voice for a 78 s target) is regenerated once with a length correction. 0 = never regenerate.
SCRIPT_LENGTH_CORRECTION=
# Apify platforms tried in order per video segment (default tiktok,x; add nothing for images - they use APIFY_IMAGE_PLATFORMS, default pinterest).
APIFY_VIDEO_PLATFORMS=
# Cost of the paid Apify searches (ja / en / broad tiers of a segment). race (default) = start all at once: fastest, but at least 2 of the 3
# paid searches are wasted whenever one tier wins. sequential = a paid tier starts only after every better tier came back empty.
# cheap_first = also wait for the free tiers (YouTube Shorts / Pinterest) and skip the paid searches when one of them already has a clip.
# Free tiers (Pexels, shorts, gallery) always start at once. Cheaper, slower when the first tier is empty. Unknown value = race.
MEDIA_TIER_MODE=
# Results asked per paid Apify search, 3..20 (default 20). Apify bills a search by the results it returns; fewer = cheaper per search, but
# fewer candidates for the relevance filters (more MEDIA_RELEVANCE_BELOW_THRESHOLD).
APIFY_SEARCH_LIMIT=
# VE2E-96: news sources shown on the create-video page (comma-separated adapter ids, e.g. yahoo_jp). Empty = none.
# Enable a source only after confirming LyOnix may use its feeds: Yahoo! JAPAN RSS is personal-use only (https://news.yahoo.co.jp/rss).
NEWS_SOURCES=
# VE2E-96: URL intake transcripts (create-video page, Phân tích). The Apify / ElevenLabs accounts in Settings > Providers are used
# first; these are only a fallback when the user has none (or force the dev mock). Keys never reach the UI or the logs.
# TikTok subtitles + video file: apify (needs TIKTOK_APIFY_TOKEN) | mock (forces the fixed dev sample, shown as mock) | empty = accounts / token only.
TIKTOK_SOURCE_PROVIDER=
TIKTOK_APIFY_TOKEN=
# Speech-to-text when a video has no subtitle: elevenlabs (needs ELEVENLABS_STT_API_KEY) | mock (forces the dev sample) | empty = accounts / key only.
STT_PROVIDER=
ELEVENLABS_STT_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
