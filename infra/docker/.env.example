# Copy to .env (same folder as docker-compose.yml). NEVER commit .env.

# --- Deployment ---
DOMAIN=example.com
# Public access: "tunnel" = Cloudflare Tunnel, "caddy" = Caddy + Let's Encrypt (needs ports 80/443)
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=
IMAGE_PREFIX=ghcr.io/locnguyen-nd/lyonix-creater
IMAGE_TAG=dev
WATCHTOWER_POLL_INTERVAL=60
# Needed only while GHCR packages are private (PAT with read:packages)
GHCR_USER=
GHCR_TOKEN=

# --- Infra secrets (any strong value) ---
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# --- App secrets (see ../../.env.example for the full list and meaning) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PERSISTENCE_ENCRYPTION_KEY=
JWT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
CREATOMATE_PREVIEW_PUBLIC_TOKEN=
CREATOMATE_RENDER_SCALE=1
MEDIA_TTL_DAYS=7
MEDIA_WORKER_QUEUE=lyonix.media
# APP_ENV=development seeds admin@lyonix.local / staff@lyonix.local with the passwords below (TEST deployments only).
# Keep production (default): no user is seeded, so a first admin must be created in the database.
APP_ENV=development
# Demo credentials for the test environment only
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
